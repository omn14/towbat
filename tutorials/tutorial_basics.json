                {"phase": "MovementPhase",  "text": "When you've finished moving, click the phase cube to go to Shooting, then Combat."},
                {"phase": "ShootingPhase",  "text": "If you have no ranged units, click the phase cube to skip to Combat."},
                {"phase": "CombatPhase",    "text": "Defending on a hill gives you a combat bonus. Use it wisely!"},
