            "id": "deployment_basics",
            "name": "Deployment",
            "description": "Learn how to deploy your army onto the battlefield before the fight begins.",
            "win_conditions": [
                {
                    "text": "Place all your units in the deployment zone",
                    "condition": {"type": "all_units_deployed"}
                }
            ],
            "hints": [
                {"phase": "DeployPhase",   "text": "Welcome, General! Before a battle begins you must deploy your army. Click on a unit to select it, then click inside the white deployment zone to place it."},
                {"phase": "DeployPhase",   "text": "The white rectangle marks your deployment zone. Units must be placed inside it. Try to spread them out so they support each other."},
                {"phase": "DeployPhase",   "text": "Once all units are placed, click the phase cube in the top-right corner to end deployment and begin the battle."},
                {"phase": "DeployPhase",   "text": "Tip: Place durable infantry in the centre and keep ranged units slightly behind. Position is everything!"},
                {"phase": "StrategyPhase", "text": "All units deployed! Each turn has four phases: Strategy, Movement, Shooting, and Combat. Click the phase cube to advance to the next phase."}
            ],
