            "id": "combat_basics",
            "name": "Close Combat",
            "description": "Learn how melee combat works — charges, to-hit rolls, wound rolls, and combat resolution.",
            "win_conditions": [
                {
                    "text": "Deploy all your units",
                    "condition": {"type": "all_units_deployed"}
                },
                {
                    "text": "Charge your knights into the enemy unit",
                    "condition": {"type": "unit_charged"}
                },
                {
                    "text": "Defeat all enemy units in close combat",
                    "condition": {"type": "destroy_all_enemies"}
                }
            ],
            "hints": [
                {"phase": "DeployPhase",   "text": "Deploy your units, then click the phase cube to start the battle."},
                {"phase": "StrategyPhase", "text": "Plan your approach — knights get a charge bonus! Click the phase cube to advance to Movement."},
                {"phase": "MovementPhase", "text": "Move your Knights close enough to charge the enemy. A charge happens when you end movement in contact."},
                {"phase": "MovementPhase", "text": "After moving, click the phase cube to advance. Skip Shooting and reach the Combat Phase."},
                {"phase": "ShootingPhase", "text": "No ranged units in this battle. Click the phase cube to advance to the Combat Phase."},
                {"phase": "CombatPhase",   "text": "Click on your engaged unit to fight. Dice are rolled to hit and wound. The loser takes a Break test."},
                {"phase": "CombatPhase",   "text": "After resolving combat, click the phase cube to end the turn. A new round begins at the Strategy Phase."}
            ],
